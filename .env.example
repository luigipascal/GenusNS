# STRIPE_SUBSCRIPTION_PRICE_GBP_PENCE=2000
# STRIPE_SUBSCRIPTION_MONTHLY_QUOTA=30
DOWNLOAD_TOKEN_DAYS=7
DOWNLOAD_MAX_COUNT=5
# Public GA4 id. PlainConsent loads gtag only after Accept analytics — do not add a raw gtag snippet in layout.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-6PWGCLL17J

# Brevo newsletter (server-only; never NEXT_PUBLIC_*)
BREVO_API_KEY=xkeysib-...
BREVO_NEWSLETTER_LIST_ID=123
# Optional — double opt-in confirmation template id from Brevo
# BREVO_DOI_TEMPLATE_ID=456
BREVO_FROM_EMAIL=genusns@genusns.com
BREVO_FROM_NAME=GENUS//NS
# Saturday 09:00 UTC Coolify/cron: GET /api/cron/newsletter-weekly?send=1
# Header: Authorization: Bearer CRON_SECRET
CRON_SECRET=...
# YouTube Dispatch feed (public RSS, no API key). Playlist optional — if set, every item is an episode.
# YOUTUBE_CHANNEL_ID=UCfGQ-cBAm7InANUFEZuxi1Q
# YOUTUBE_PODCAST_PLAYLIST_ID=
# HMAC for welcome-letter unsubscribe links (optional; falls back to CRON_SECRET)
