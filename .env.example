# While GENUS//NS host is offline, use 0dblabs.com for Checkout + webhooks
NEXT_PUBLIC_SITE_URL=https://0dblabs.com
STRIPE_WEBHOOK_PUBLIC_URL=https://0dblabs.com/api/webhooks/stripe
# Signing secret from Stripe Dashboard → webhook we_1S1VVx… → Reveal
STRIPE_WEBHOOK_SECRET=whsec_...

GENUSNS_DATA_DIR=/app/data
STRIPE_TRACK_PRICE_GBP_PENCE=199
