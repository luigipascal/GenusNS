{
  "name": "genusns",
  "private": true,
  "version": "0.1.0",
  "description": "GENUS//NS — publication layer, registry, living interface",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @genusns/web dev",
    "build": "pnpm --filter @genusns/web build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "covers": "pnpm --filter @genusns/pipeline covers",
    "pipeline": "pnpm --filter @genusns/pipeline pipeline",
    "kits": "pnpm --filter @genusns/pipeline kits"
  },
  "engines": {
    "node": ">=20"
  }
}
